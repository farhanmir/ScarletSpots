# Root environment for docker-compose.yml
# Copy to .env and fill before running docker compose.

# Supabase configuration used by backend/.env templating in deployments
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DEBUG=false

# PostgreSQL password used by db + backend connection string
DB_PASSWORD=change-me

# Optional: required only if duckdns service is enabled
DUCKDNS_TOKEN=
