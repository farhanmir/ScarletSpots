PROJECT_NAME="ScarletSpots API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8081", "exp://localhost:19000"]'

# ---------------------------------------------------------------------------
# Logto OIDC Auth
# ---------------------------------------------------------------------------
# Internal Docker service URL (backend container → logto container)
LOGTO_ENDPOINT=http://logto:3001
# PUBLIC issuer URL — must match the `iss` claim in Logto-issued tokens.
# Set to http://localhost:3001/oidc for local docker, or your public host in prod.
LOGTO_ISSUER=http://localhost:3001/oidc
# Audience (resource indicator of your API resource in Logto, if configured)
LOGTO_AUDIENCE=
LOGTO_VERIFY_AUDIENCE=false

# ---------------------------------------------------------------------------
# Logto Machine-to-Machine App (for backend admin operations)
# ---------------------------------------------------------------------------
# Create an M2M app in the Logto admin console (http://<server>:3002)
# and assign it the "Management API access" role.
LOGTO_M2M_APP_ID=replace-after-creating-m2m-app
LOGTO_M2M_APP_SECRET=replace-after-creating-m2m-app
# Resource identifier for Logto Management API (default for self-hosted)
LOGTO_MANAGEMENT_API_RESOURCE=https://default.logto.app/api

# ---------------------------------------------------------------------------
# Logto Docker settings (used by docker-compose.yml logto-db service)
# ---------------------------------------------------------------------------
LOGTO_DB_NAME=logto
LOGTO_DB_USER=logto
LOGTO_DB_PASSWORD=change-me
# Public hostname/IP of your server (for Logto's ENDPOINT and ADMIN_ENDPOINT)
SERVER_HOST=localhost

# ---------------------------------------------------------------------------
# Application PostgreSQL (used by docker-compose.yml app-db service)
# ---------------------------------------------------------------------------
APP_DB_NAME=scarletspots
APP_DB_USER=scarlet_admin
APP_DB_PASSWORD=change-me

# DATABASE_URL is injected automatically by docker-compose.yml for the backend container.
# Only set manually for local (non-Docker) dev:
# DATABASE_URL=postgresql+asyncpg://scarlet_admin:change-me@localhost:5432/scarletspots

# ---------------------------------------------------------------------------
# pgAdmin4
# ---------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@scarletspots.app
PGADMIN_DEFAULT_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
EXPO_PUSH_ACCESS_TOKEN=
