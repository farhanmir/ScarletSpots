PROJECT_NAME="ScarletSpots API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8081", "exp://localhost:19000"]'

# Supabase Local (or Remote) configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Optional: set when using asymmetric (ES256) JWT verification without JWKS fetch
SUPABASE_JWT_PUBLIC_KEY=

# Optional: Expo account access token for authenticated push dispatch
# (safe to leave empty for now during local development)
EXPO_PUSH_ACCESS_TOKEN=

# OCI PostgreSQL Connection
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/scarletspots
