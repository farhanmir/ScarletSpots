PROJECT_NAME="ScarletSpots API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8081", "exp://localhost:19000"]'

# ---------------------------------------------------------------------------
# Keycloak authentication
# ---------------------------------------------------------------------------
# Internal Docker Compose URL (used by backend container → keycloak container)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=scarletspots
# Optional explicit override. If empty, issuer is derived as {KEYCLOAK_URL}/realms/{KEYCLOAK_REALM}
KEYCLOAK_ISSUER=
# Audience expected in access tokens (client id of the mobile/web client)
KEYCLOAK_AUDIENCE=scarletspots-mobile
KEYCLOAK_VERIFY_AUDIENCE=true
# Optional explicit PEM public key; leave empty to use Keycloak JWKS automatically
KEYCLOAK_JWT_PUBLIC_KEY=

# Keycloak admin client used by signup/password-reset backend endpoints
KEYCLOAK_ADMIN_CLIENT_ID=scarletspots-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-secret
# Optional values for reset-email action links
KEYCLOAK_PASSWORD_RESET_CLIENT_ID=scarletspots-mobile
KEYCLOAK_PASSWORD_RESET_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Keycloak docker bootstrap settings  (used by root docker-compose.yml)
# ---------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Application PostgreSQL  (used by root docker-compose.yml)
# ---------------------------------------------------------------------------
APP_DB_NAME=scarletspots
APP_DB_USER=scarlet_admin
APP_DB_PASSWORD=change-me

# DATABASE_URL is injected by docker-compose.yml automatically.
# Only set this manually for local (non-Docker) development:
# DATABASE_URL=postgresql+asyncpg://scarlet_admin:change-me@localhost:5432/scarletspots

# ---------------------------------------------------------------------------
# pgAdmin4
# ---------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@scarletspots.app
PGADMIN_DEFAULT_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Optional extras
# ---------------------------------------------------------------------------
# Expo push notification access token (leave empty if not using paid Expo plan)
EXPO_PUSH_ACCESS_TOKEN=
