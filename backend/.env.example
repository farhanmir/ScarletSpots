# Core API configuration
PROJECT_NAME="ScarletSpots API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
DEBUG=False

# CORS Origins (JSON list)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8081", "exp://localhost:19000"]'

# Supabase configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"
SUPABASE_JWT_ISSUER="https://your-project.supabase.co/auth/v1"
SUPABASE_JWT_AUDIENCE="authenticated"

# High-value parking data policy
REQUIRE_AUTH_ON_AVAILABILITY=True
REQUIRE_ATTESTATION_ON_AVAILABILITY=False
ATTESTATION_ENFORCE=False
ATTESTATION_ALLOW_GRACE_MINUTES=10
ATTESTATION_NONCE_MAX_AGE_SECONDS=300
ATTESTATION_SIGNING_SECRET="replace-with-strong-random-secret"

# PostgreSQL Connection
# Use 'db' as the hostname for Docker
DATABASE_URL="postgresql+asyncpg://scarlet_admin:your_password@db:5432/scarletspots"

# Redis (Use 'redis' as the hostname for Docker)
REDIS_URL="redis://redis:6379/0"

# Optional: Expo Push Token
EXPO_PUSH_ACCESS_TOKEN=""
