EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# API backend url (optional, used if not falling back to simulator localhost IPs)
EXPO_PUBLIC_API_URL=https://scarletspots.duckdns.org/api/v1

# Auto-parking detection minimum confidence (0.5 to 1.0, default 0.8)
EXPO_PUBLIC_PARKING_CONFIDENCE_THRESHOLD=0.8

# Enable heading-change signal in parking detection pipeline
EXPO_PUBLIC_HEADING_SIGNAL_ENABLED=true

# Enable offline queue for deferred actions when network is unavailable
EXPO_PUBLIC_OFFLINE_QUEUE_ENABLED=true

# Enable all Rutgers campuses (true) or only New Brunswick (false)
EXPO_PUBLIC_ENABLE_ALL_CAMPUSES=false
